<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>

    <!-- NuGet Package Properties -->
    <PackageId>StrictGuid</PackageId>
    <Version>1.0.0</Version>
    <Authors>Alex</Authors>
    <Description>High-performance, zero-allocation library for UUID v8 (RFC 9562) with strongly typed embedded entities.</Description>
    <PackageTags>guid;uuid;uuidv8;performance;zero-allocation;strongly-typed</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
